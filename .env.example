# Copy this file to .env.local and fill in the two values.
# Find both in Supabase: Project Settings -> API (or the "Connect" button).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "Publishable key" (starts with sb_publishable_...). An older "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Your live website address. Use http://localhost:3000 while testing on your computer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
